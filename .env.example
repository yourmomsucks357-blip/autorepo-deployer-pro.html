# OfferOnly lead delivery — all optional.
# Forms always log every lead to the server console (visible in Vercel logs),
# so nothing is required for leads to be captured. Set any of the following to
# also forward leads to that destination. Copy to `.env.local` for local dev.

# POST the full JSON lead to any HTTPS endpoint (Zapier, Make, your own API).
LEAD_WEBHOOK_URL=

# Slack Incoming Webhook URL — posts a readable summary of each lead.
LEAD_SLACK_WEBHOOK_URL=

# Email notifications via Resend (https://resend.com).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=        # where lead emails are sent (comma-separated for many)
LEAD_FROM_EMAIL=          # verified sender, e.g. "OfferOnly <leads@offeronly.com>"

# Append newline-delimited JSON leads to this file. Great for local dev /
# self-hosting. Ignored on Vercel (ephemeral filesystem).
LEAD_STORE_FILE=
