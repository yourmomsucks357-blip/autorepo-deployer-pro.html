{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.offeronly.com" }],
      "destination": "https://offeronly.com/$1",
      "permanent": true
    }
  ]
}
